# release.env — how Tools/release/release.sh (and Dev's Release tool) ships this app.
# Shell syntax: KEY=value, quotes for values with spaces.

APP_NAME=MyApp                 # the .app's name and the download's file name
SCHEME=MyApp
PROJECT=MyApp.xcodeproj        # or WORKSPACE=MyApp.xcworkspace
PLATFORM=macos                 # macos, ios, windows, linux or android (a workflow step can pick another)
TEAM_ID=ABCDE12345

# Tests and screenshots (empty = skip)
TEST_SCHEME=
TEST_DESTINATION=              # macOS default: platform=macOS; iOS: "platform=iOS Simulator,id=<UDID>"
SCREENSHOT_TEST=               # e.g. MyAppUITests/ScreenshotTests
SCREENSHOT_LOCALES="en-US"     # language-REGION list, e.g. "en-US de-DE ja-JP"
SCREENSHOT_DESTINATION=

# Direct download (macOS): Developer ID signed, notarized, stapled
DIRECT_DOWNLOAD="zip dmg"
DIRECT_ARCHS="universal"       # universal, arm64, or both ("universal arm64": <App> + <App>-AppleSilicon)
DIRECT_SETTINGS=               # one build setting for the macOS archive the downloads come from, e.g.
                               # 'SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) DIRECT_DISTRIBUTION'
NOTARY_PROFILE=                # created once with: xcrun notarytool store-credentials <name>

# GitHub Releases
GITHUB_REPO=                   # owner/repo
GITHUB_DRAFT=yes               # yes = create a draft you publish by hand

# App Store Connect (uses Xcode's account unless an API key is given)
APP_STORE=no
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Windows and Linux: built on another machine over SSH (a Dev workflow step's VM, or --host), from this Mac's
# checkouts of every package the app builds from (V57_LOCAL=1), with v57/SwiftUI's build-app scripts.
PACKAGE_PATH=                  # the SwiftPM package (default: App when App/Package.swift exists, else .)
WINDOWS_PRODUCT=               # default <App>WinUI: <App>-Windows-<arch>.zip
WINDOWS_HOST=                  # user@address when no --host is given
LINUX_PRODUCT=                 # default <App>: <App>-Linux-<arch>.tar.gz
LINUX_HOST=
LINUX_STATIC=yes               # the Swift runtime linked in (runs without Swift installed)

# Android (not built yet): cross-compiled on this Mac, a release-signed <App>-Android.apk.
ANDROID_PRODUCT=               # default <App>Android
ANDROID_KEYSTORE=              # the release key, kept on this Mac and backed up
ANDROID_KEY_ALIAS=
ANDROID_KEYCHAIN_ITEM=         # keychain item holding the keystore's password (default android-release-key)

# Stores (not built yet: the steps check these and say what's missing)
GOOGLE_PLAY=no
GOOGLE_PLAY_TRACK=internal
GOOGLE_PLAY_KEY_PATH=          # a Play Console service account key
MS_STORE=no
MS_STORE_APP_ID=               # the app's Store ID in Partner Center
