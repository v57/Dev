# release.env — how Tools/release/release.sh (and Dev's Release tool) ships this app.
# Shell syntax: KEY=value, quotes for values with spaces.

APP_NAME=MyApp                 # the .app's name and the download's file name
SCHEME=MyApp
PROJECT=MyApp.xcodeproj        # or WORKSPACE=MyApp.xcworkspace
PLATFORM=macos                 # macos or ios
TEAM_ID=ABCDE12345

# Tests and screenshots (empty = skip)
TEST_SCHEME=
TEST_DESTINATION=              # macOS default: platform=macOS; iOS: "platform=iOS Simulator,id=<UDID>"
SCREENSHOT_TEST=               # e.g. MyAppUITests/ScreenshotTests
SCREENSHOT_LOCALES="en-US"     # language-REGION list, e.g. "en-US de-DE ja-JP"
SCREENSHOT_DESTINATION=

# Direct download (macOS): Developer ID signed, notarized, stapled
DIRECT_DOWNLOAD="zip dmg"
NOTARY_PROFILE=                # created once with: xcrun notarytool store-credentials <name>

# GitHub Releases
GITHUB_REPO=                   # owner/repo
GITHUB_DRAFT=yes               # yes = create a draft you publish by hand

# App Store Connect (uses Xcode's account unless an API key is given)
APP_STORE=no
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
