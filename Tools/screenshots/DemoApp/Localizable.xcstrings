{
  "sourceLanguage": "en",
  "strings": {
    "Welcome back, %@!": {
      "comment": "Greeting on the home screen; %@ is the user's first name",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück, %@!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour, %@ !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola de nuevo, %@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかえりなさい、%@さん！"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato, %@!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Que bom ver você de novo, %@!"
          }
        }
      }
    },
    "Save changes": {
      "comment": "Button that saves the edited profile",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen sichern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les modifications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar cambios"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva modifiche"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar alterações"
          }
        }
      }
    },
    "Your library is empty": {
      "comment": "Empty state title in the photo library",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek ist leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca está vacía"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは空です"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria è vuota"
          }
        }
      }
    },
    "Import photos to start editing.": {
      "comment": "Empty state message under the title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Fotos, um mit der Bearbeitung zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importez des photos pour commencer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa fotos para empezar a editar."
