    "This can't be undone.": {
      "comment": "Confirmation message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non può essere annullata."
